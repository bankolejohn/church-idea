# Application
NODE_ENV=development
PORT=3000

# Database (update credentials for your environment)
# Local Docker: postgresql://churchadmin:churchpass@localhost:5432/church_db
# Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>
DB_SSL=false
DB_POOL_MAX=20

# Authentication (CHANGE THESE IN PRODUCTION)
JWT_SECRET=<generate-a-strong-random-string>
ADMIN_PASSWORD=<set-a-secure-admin-password>

# AI Image Extraction (Monthly Returns feature)
OPENAI_API_KEY=<your-openai-api-key>

# Security
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
