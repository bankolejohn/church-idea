# AI SRE Agent Configuration
# Copy this to .env and fill in your values

# Claude API Key (get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# AWS Configuration (uses your CLI credentials if not set)
AWS_REGION=us-east-1
ECS_CLUSTER=church-cms-prod-cluster
ECS_SERVICE=church-cms-prod-service
RDS_INSTANCE=church-cms-prod-db
ALB_NAME=church-cms-prod-alb
LOG_GROUP=/ecs/church-cms-prod

# Application
APP_URL=https://app.johndesiventures.website
APP_NAME=church-cms

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=

# Agent Behavior
AUTO_FIX_ENABLED=true           # Allow agent to apply fixes
REQUIRE_HUMAN_APPROVAL=true     # Require approval for destructive actions
MAX_RETRIES=3                   # Max fix attempts before escalating
